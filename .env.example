# Local-development PostgreSQL settings. Replace these outside local development.
POSTGRES_DB=latm
POSTGRES_USER=latm
POSTGRES_PASSWORD=latm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://latm:latm@localhost:5432/latm

# Paper is the only supported execution mode. Missing values also default safely to paper.
TRADING_MODE=paper

# Next.js reads the API server-side; Compose overrides this with http://backend:8000.
BACKEND_API_URL=http://localhost:8000

# Phase 1 reads public production market data only; it never submits orders.
PREDICTION_MARKET_PROVIDER=kalshi
KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
PROVIDER_REQUEST_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
PROVIDER_MAX_PAGES=50

# Phase 2 sports data. Create a free key at https://app.balldontlie.io.
# Select `mlb` for the credential-free official MLB Stats API adapter.
SPORTS_DATA_PROVIDER=balldontlie
BALLDONTLIE_API_KEY=
BALLDONTLIE_API_BASE_URL=https://api.balldontlie.io/v1
MLB_API_BASE_URL=https://statsapi.mlb.com/api/v1
SPORTS_PROVIDER_MAX_PAGES=10
# The free tier permits 5 requests/minute, so paginated calls are paced by default.
SPORTS_PROVIDER_REQUEST_INTERVAL_SECONDS=12.1
# Conservative pacing for the public MLB source; no authentication is used.
MLB_PROVIDER_REQUEST_INTERVAL_SECONDS=0.25

# Phase 3 deterministic market-to-event matching policy.
MATCHING_MIN_CONFIDENCE=0.90
MATCHING_AMBIGUITY_MARGIN=0.10
MATCHING_TIME_WINDOW_HOURS=36

# Phase 5 deterministic directional raw-edge policy. 0.03 means 3 percentage points.
OPPORTUNITY_WATCH_MIN_RAW_EDGE=0.03
OPPORTUNITY_TRADE_CANDIDATE_MIN_RAW_EDGE=0.08
OPPORTUNITY_MAX_MARKET_PRICE_AGE_SECONDS=900
OPPORTUNITY_MAX_OPERATIONAL_FORECAST_AGE_SECONDS=86400

# Phase 6 paper portfolio and advisory raw-edge sizing. Proposals never reserve or execute.
PAPER_STARTING_BANKROLL=1000.00
POSITION_SIZING_CANDIDATE_MIN_RAW_EDGE=0.08
POSITION_SIZING_STRONG_MIN_RAW_EDGE=0.12
POSITION_SIZING_VERY_STRONG_MIN_RAW_EDGE=0.18
POSITION_SIZING_CANDIDATE_EXPOSURE_FRACTION=0.02
POSITION_SIZING_STRONG_EXPOSURE_FRACTION=0.05
POSITION_SIZING_VERY_STRONG_EXPOSURE_FRACTION=0.08
POSITION_SIZING_MAX_EXPOSURE_FRACTION=0.08

# Phase 7 deterministic paper-only risk policy. Decisions authorize risk only; they do not trade.
RISK_AUTO_APPROVE_EXPOSURE_MAX=0.10
RISK_HIGH_CONFIDENCE_AUTO_APPROVE_MAX=0.40
RISK_MIN_RAW_EDGE=0.08
RISK_MIN_MATCH_CONFIDENCE=0.90
RISK_MAX_MARKET_PRICE_AGE_SECONDS=900
RISK_MAX_OPERATIONAL_FORECAST_AGE_SECONDS=86400
RISK_AUTHORIZATION_TTL_SECONDS=300

# Phase 8 provider-free immediate paper-fill assumptions, in basis points.
PAPER_SLIPPAGE_BPS=25.00
PAPER_FEE_BPS=10.00

# Phase 9 deterministic paper position monitoring and conservative exit assumptions.
POSITION_MONITOR_MIN_HOLD_EDGE=0.03
POSITION_MONITOR_REDUCE_FRACTION=0.50
POSITION_MONITOR_MAX_MARKET_PRICE_AGE_SECONDS=900
POSITION_MONITOR_MAX_OPERATIONAL_FORECAST_AGE_SECONDS=86400
PAPER_EXIT_SLIPPAGE_BPS=25.00
PAPER_EXIT_FEE_BPS=10.00

# Phase 10 fixed-width calibration reliability table.
EVALUATION_CALIBRATION_BIN_COUNT=10

# Host ports may be changed when another local service already uses a default port.
BACKEND_PORT=8000
FRONTEND_PORT=3000
