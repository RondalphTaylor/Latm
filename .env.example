# Local-development PostgreSQL settings. Replace these outside local development.
POSTGRES_DB=latm
POSTGRES_USER=latm
POSTGRES_PASSWORD=latm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://latm:latm@localhost:5432/latm

# Paper is the only supported execution mode. Missing values also default safely to paper.
TRADING_MODE=paper

# Phase 1 reads public production market data only; it never submits orders.
PREDICTION_MARKET_PROVIDER=kalshi
KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
PROVIDER_REQUEST_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
PROVIDER_MAX_PAGES=50

# Phase 2 sports data. Create a free key at https://app.balldontlie.io.
SPORTS_DATA_PROVIDER=balldontlie
BALLDONTLIE_API_KEY=
BALLDONTLIE_API_BASE_URL=https://api.balldontlie.io/v1
SPORTS_PROVIDER_MAX_PAGES=10
# The free tier permits 5 requests/minute, so paginated calls are paced by default.
SPORTS_PROVIDER_REQUEST_INTERVAL_SECONDS=12.1

# Phase 3 deterministic market-to-event matching policy.
MATCHING_MIN_CONFIDENCE=0.90
MATCHING_AMBIGUITY_MARGIN=0.10
MATCHING_TIME_WINDOW_HOURS=36

# Host ports may be changed when another local service already uses a default port.
BACKEND_PORT=8000
FRONTEND_PORT=3000
